# Fastfile
# Reference: https://docs.fastlane.tools/actions/

default_platform(:android)

platform :android do
  desc "Runs code linting and code style checks via Gradle"
  lane :lint do
    gradle(task: "lintDebug")
  end

  desc "Runs local JUnit and Robolectric JVM tests"
  lane :test do
    gradle(task: "testDebugUnitTest")
  end

  desc "Compiles a clean debug APK for development testing"
  lane :build_debug do
    gradle(task: "clean")
    gradle(task: "assembleDebug")
  end

  desc "Builds a production release Android App Bundle (AAB)"
  lane :build_release do
    gradle(task: "clean")
    gradle(task: "bundleRelease")
  end

  desc "Deploy a beta build to Firebase App Distribution or Play Store Internal Testing"
  lane :deploy_beta do
    # Run quality gates first
    test
    
    # Compile the build
    gradle(task: "assembleRelease")

    # Upload to Beta
    # upload_to_play_store(
    #   track: 'internal',
    #   apk: 'app/build/outputs/apk/release/app-release.apk'
    # )
    
    UI.success("Beta deployment complete!")
  end

  desc "Promote beta build to Google Play production track"
  lane :release do
    build_release
    
    # upload_to_play_store(
    #   track: 'production',
    #   aab: 'app/build/outputs/bundle/release/app-release.aab'
    # )
    
    UI.success("Google Play Release deployment complete!")
  end
end
