<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mini_player_outer"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:padding="4dp">

    <LinearLayout
        android:id="@+id/mini_player_root"
        android:layout_width="328dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_mini_player"
        android:clickable="true"
        android:elevation="12dp"
        android:focusable="false"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="6dp"
        android:paddingEnd="10dp"
        android:paddingBottom="10dp">

        <!-- Drag handle pill -->
        <View
            android:id="@+id/view_drag_handle"
            android:layout_width="32dp"
            android:layout_height="3dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="4dp"
            android:background="@drawable/bg_mini_player_handle" />

        <!-- Primary Row: Track Info + Transport Controls + Dismiss -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/layout_track_info"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingEnd="6dp">

                <TextView
                    android:id="@+id/tv_mini_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="marquee"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:marqueeRepeatLimit="marquee_forever"
                    android:scrollHorizontally="true"
                    android:singleLine="true"
                    android:text="@string/mini_player_idle_title"
                    android:textColor="#FFFFFFFF"
                    android:textSize="13.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_mini_artist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/mini_player_idle_artist"
                    android:textColor="#B8C0CE"
                    android:textSize="11.5sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btn_mini_prev"
                android:layout_width="40dp"
                android:layout_height="44dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/mini_player_cd_prev"
                android:scaleType="centerInside"
                android:src="@android:drawable/ic_media_previous"
                android:tint="#FFFFFFFF" />

            <ImageButton
                android:id="@+id/btn_mini_play_pause"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/mini_player_cd_play_pause"
                android:scaleType="centerInside"
                android:src="@android:drawable/ic_media_play"
                android:tint="#FF1DB954" />

            <ImageButton
                android:id="@+id/btn_mini_next"
                android:layout_width="40dp"
                android:layout_height="44dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/mini_player_cd_next"
                android:scaleType="centerInside"
                android:src="@android:drawable/ic_media_next"
                android:tint="#FFFFFFFF" />

            <ImageButton
                android:id="@+id/btn_mini_close"
                android:layout_width="36dp"
                android:layout_height="44dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/mini_player_cd_close"
                android:scaleType="centerInside"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                android:tint="#99FFFFFF" />
        </LinearLayout>

        <!-- Compact Media Volume Slider Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/iv_mini_volume"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginEnd="6dp"
                android:contentDescription="@string/mini_player_cd_volume"
                android:src="@android:drawable/ic_lock_silent_mode_off"
                android:tint="#FF1DB954" />

            <SeekBar
                android:id="@+id/seek_mini_volume"
                android:layout_width="0dp"
                android:layout_height="28dp"
                android:layout_weight="1"
                android:paddingStart="6dp"
                android:paddingEnd="8dp"
                android:progressTint="#FF1DB954"
                android:thumbTint="#FFFFFFFF" />

            <TextView
                android:id="@+id/tv_mini_volume_pct"
                android:layout_width="36dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:textColor="#B8C0CE"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
